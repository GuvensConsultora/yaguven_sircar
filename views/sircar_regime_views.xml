<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sircar_regime_list" model="ir.ui.view">
        <field name="name">yaguven.sircar.regime.list</field>
        <field name="model">yaguven.sircar.regime</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="jurisdiction_id"/>
                <field name="kind"/>
                <field name="code"/>
                <field name="name"/>
                <field name="min_amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sircar_regime_form" model="ir.ui.view">
        <field name="name">yaguven.sircar.regime.form</field>
        <field name="model">yaguven.sircar.regime</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="jurisdiction_id"/>
                        <field name="kind"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="min_amount"/>
                        <field name="active"/>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sircar_regime" model="ir.actions.act_window">
        <field name="name">Regímenes SIRCAR</field>
        <field name="res_model">yaguven.sircar.regime</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
